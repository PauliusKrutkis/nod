---
import Base from "../layouts/Base.astro";
import DiffReplay from "../components/DiffReplay.astro";
import FeatureCache from "../components/FeatureCache.astro";
import FeatureKeys from "../components/FeatureKeys.astro";
import FeatureResume from "../components/FeatureResume.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
---

<Base
  title="Nod — keyboard-first PR review"
  description="A keyboard-first, cache-first desktop app for reviewing GitHub pull requests. Closer to triaging an inbox than navigating a website."
>
  <SiteNav cta={{ href: "/downloads", label: "Download" }} />

  <main>
    <section class="wrap hero">
      <p class="eyebrow">A desktop app for GitHub pull requests</p>
      <h1 class="hero__title">Review PRs like an <em>inbox</em>, not a website.</h1>
      <p class="hero__sub">
        Keyboard-first and cache-first, for the thing you do every day: open a
        review request, read the diff, leave a comment, move on.
      </p>

      <DiffReplay />

      <div class="get">
        <a class="btn btn--primary" href="/downloads">Download Nod</a>
        <p class="get__note">
          macOS, Windows, and Linux — or install with{" "}<a
            href="/downloads#homebrew">Homebrew</a
          >. Free while it's an experiment.
        </p>
      </div>
    </section>

    <section class="wrap feats" aria-label="Features in action">
      <p class="eyebrow feats__eyebrow">In action</p>
      <FeatureKeys />
      <FeatureCache />
      <FeatureResume />
    </section>
  </main>

  <SiteFooter />
</Base>

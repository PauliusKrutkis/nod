---
import Base from "../layouts/Base.astro";
import InboxReplay from "../components/InboxReplay.astro";
import FeatureShowcase from "../components/FeatureShowcase.astro";
import LocalStrip from "../components/LocalStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";

// The buy button appears only when a checkout exists (build-time env, set
// once the merchant account is live); until then the pricing card is honest
// about it and leads with the free intro instead of a dead button.
const checkoutUrl = import.meta.env.PUBLIC_CHECKOUT_URL as string | undefined;
---

<Base
  title="Nod — keyboard-first PR review"
  description="A keyboard-first, cache-first desktop app for reviewing GitHub pull requests. Closer to triaging an inbox than navigating a website."
>
  <SiteNav cta={{ href: "/downloads", label: "Download" }} />

  <main>
    <section class="wrap hero">
      <p class="eyebrow">A desktop app for GitHub pull requests</p>
      <h1 class="hero__title">Review PRs like an <em>inbox</em>, not a website.</h1>
      <p class="hero__sub">
        Keyboard-first and cache-first, for the thing you do every day: open a
        review request, read the diff, leave a comment, move on.
      </p>

      <div class="get">
        <a class="btn btn--primary" href="/downloads">Download Nod</a>
        <p class="get__note">
          macOS, Windows, and Linux — or install with{" "}<a
            href="/downloads#homebrew">Homebrew</a
          >. Free to evaluate — no time limit.
        </p>
      </div>

      <InboxReplay />
    </section>

    <section class="wrap feats" aria-label="Features in action">
      <p class="eyebrow feats__eyebrow">In action</p>
      <div class="feats__rows">
        <FeatureShowcase
          title="The whole loop, no mouse"
          body="Triage the queue with j and k, open with Enter, step the diff, mark files viewed, submit — one unbroken keyboard motion."
          scene="loop"
          label="Real footage of Nod: triaging the inbox with j and k, opening a pull request, marking files viewed, and submitting the review."
        >
          <kbd class="show__key">j</kbd>
          <kbd class="show__key">k</kbd> triage · <kbd class="show__key">e</kbd>
          viewed · <kbd class="show__key">s</kbd> submit
        </FeatureShowcase>
        <FeatureShowcase
          title="Comment without breaking stride"
          body="c opens a composer on the cursor line. Batch comments into a pending review or send one now — either way it lands instantly."
          scene="comments"
          label="Real footage of Nod: opening an inline composer on the cursor line, typing a comment, and adding it to a pending review."
        >
          <kbd class="show__key">c</kbd> comment ·
          <kbd class="show__key">⌘↵</kbd> add to review
        </FeatureShowcase>
        <FeatureShowcase
          title="Built for reading diffs"
          body="Click a token and every occurrence lights up. Find-in-diff ticks its matches on an overview ruler, and intraline emphasis shows exactly what a rename changed."
          scene="scan"
          label="Real footage of Nod: occurrence marks lighting up on a clicked token, then find-in-diff stepping through matches marked on the overview ruler."
        >
          double-click marks · <kbd class="show__key">⌘F</kbd> find in the diff
        </FeatureShowcase>
      </div>
    </section>

    <LocalStrip />

    <section class="wrap pricing" aria-label="Pricing" id="pricing">
      <p class="eyebrow">Pricing</p>
      <div class="pricing__card">
        <p class="pricing__price">
          $39 <span class="pricing__term">one-time · a year of updates</span>
        </p>
        <p class="pricing__copy">
          Nod is free to evaluate, every feature, no time limit. A license
          funds development and keeps the updates coming.
        </p>
        {
          checkoutUrl ? (
            <a class="btn btn--primary" href={checkoutUrl}>
              Buy Nod
            </a>
          ) : (
            <a class="btn btn--primary" href="/downloads">
              Evaluate for free
            </a>
          )
        }
        {
          !checkoutUrl && (
            <p class="pricing__note">
              Purchasing opens soon — the intro is full-featured.
            </p>
          )
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

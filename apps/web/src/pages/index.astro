---
import Base from "../layouts/Base.astro";
import HeroDemo from "../components/HeroDemo.astro";
import FeatureShowcase from "../components/FeatureShowcase.astro";
import LocalStrip from "../components/LocalStrip.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import { CONTACT_EMAIL } from "../lib/site";

// The buy button appears only when a checkout exists (build-time env, set
// once the merchant account is live); until then the pricing card states the
// price and says so, rather than carrying a dead button. It deliberately does
// not fall back to a download link: the install band directly above it is
// already the free path, and two identical asks in a row read as filler.
const checkoutUrl = import.meta.env.PUBLIC_CHECKOUT_URL as string | undefined;
---

<Base
  title="Nod · keyboard-first PR review"
  description="A keyboard-first, cache-first desktop app for reviewing GitHub and GitLab pull requests. Closer to triaging an inbox than navigating a website."
>
  <SiteNav cta={{ href: "/downloads", label: "Download" }} />

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">A desktop app for GitHub and GitLab pull requests</p>
        <h1 class="hero__title" aria-label="Review PRs like an inbox, not a website.">
          <span aria-hidden="true"
            >Review PRs like <del class="hero__del">a website</del>{" "}<ins
              class="hero__ins">an inbox</ins
            >.</span
          >
        </h1>
        <p class="hero__sub">
          Keyboard-first and cache-first, for the thing you do every day: open a
          review request, read the diff, leave a comment, move on.
        </p>
      </div>

      <HeroDemo />
    </section>

    <section class="feats" aria-label="Features in action">
      <div class="feats__rows">
        <FeatureShowcase
          keys={["j", "k"]}
          title="The whole loop, no mouse"
          body="Triage the queue with j and k, open with Enter, step through the diff, mark files viewed, submit your review. The mouse never comes into it."
          scene="loop"
          label="Real footage of Nod: triaging the inbox with j and k, opening a pull request, marking files viewed, and submitting the review."
        >
          <kbd class="keycap">j</kbd>
          <kbd class="keycap">k</kbd> triage · <kbd class="keycap">e</kbd>
          viewed · <kbd class="keycap">s</kbd> submit
        </FeatureShowcase>
        <FeatureShowcase
          keys={["c"]}
          title="Comment without breaking stride"
          body="c opens a composer on the cursor line. Batch comments into a pending review, or send one on its own; both land instantly."
          scene="comments"
          label="Real footage of Nod: opening an inline composer on the cursor line, typing a comment, and adding it to a pending review."
        >
          <kbd class="keycap">c</kbd> comment ·{" "}<span
            class="show__chord"
            ><kbd class="keycap">⌘</kbd><kbd class="keycap">↵</kbd></span
          >{" "}add to review
        </FeatureShowcase>
        <FeatureShowcase
          keys={["⌘", "F"]}
          title="Built for reading diffs"
          body="Double-click a token and every occurrence lights up. Find-in-diff ticks its matches on an overview ruler, and intraline emphasis shows exactly what a rename changed."
          scene="scan"
          label="Real footage of Nod: occurrence marks lighting up on a clicked token, then find-in-diff stepping through matches marked on the overview ruler."
        >
          double-click marks ·{" "}<span class="show__chord"
            ><kbd class="keycap">⌘</kbd><kbd class="keycap">F</kbd></span
          >{" "}find in the diff
        </FeatureShowcase>
      </div>
    </section>

    <LocalStrip />

    <section class="install" aria-label="Download">
      <div class="wrap install__inner">
        <h2 class="install__title">Take it to your own PRs.</h2>
        <a class="btn btn--primary" href="/downloads">Download Nod</a>
        <p class="install__note">
          macOS, Windows, and Linux, or install with{" "}<a
            href="/downloads#homebrew">Homebrew</a
          >. Free to evaluate, no time limit.
        </p>
      </div>
    </section>

    <section class="pricing" aria-label="Pricing" id="pricing">
      <div class="wrap pricing__inner">
        <p class="eyebrow">Pricing</p>
        <p class="pricing__price">
          $59 <span class="pricing__term">one-time · a year of updates</span>
        </p>
        <p class="pricing__copy">
          Nod is free to evaluate, every feature, no time limit. Buy it once
          and the app is yours permanently: the first year brings every new
          version as it ships, and when that year is up Nod keeps working
          exactly as it is. You stop receiving updates, nothing else.
        </p>
        <p class="pricing__copy">
          No subscription, and nothing resold on top: Nod is a tool you own,
          not a seat you rent. AI is not part of it either. If you want the
          optional ask-about-code feature, you bring a provider key of your
          own and it talks to that provider directly.
        </p>
        {
          checkoutUrl ? (
            <a class="btn btn--primary" href={checkoutUrl}>
              Buy Nod
            </a>
          ) : (
            <p class="pricing__note">
              Purchasing opens soon. Until then, the free evaluation is the
              full app. Buying for a team?{" "}<a
                href={`mailto:${CONTACT_EMAIL}`}>Email me</a
              > and I'll sort out invoicing.
            </p>
          )
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

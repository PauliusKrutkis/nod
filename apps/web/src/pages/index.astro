---
import Base from "../layouts/Base.astro";
import DiffReplay from "../components/DiffReplay.astro";
import FeatureCache from "../components/FeatureCache.astro";
import FeatureKeys from "../components/FeatureKeys.astro";
import FeatureResume from "../components/FeatureResume.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";

// The buy button appears only when a checkout exists (build-time env, set
// once the merchant account is live); until then the pricing card is honest
// about it and leads with the free intro instead of a dead button.
const checkoutUrl = import.meta.env.PUBLIC_CHECKOUT_URL as string | undefined;
---

<Base
  title="Nod — keyboard-first PR review"
  description="A keyboard-first, cache-first desktop app for reviewing GitHub pull requests. Closer to triaging an inbox than navigating a website."
>
  <SiteNav cta={{ href: "/downloads", label: "Download" }} />

  <main>
    <section class="wrap hero">
      <p class="eyebrow">A desktop app for GitHub pull requests</p>
      <h1 class="hero__title">Review PRs like an <em>inbox</em>, not a website.</h1>
      <p class="hero__sub">
        Keyboard-first and cache-first, for the thing you do every day: open a
        review request, read the diff, leave a comment, move on.
      </p>

      <DiffReplay />

      <div class="get">
        <a class="btn btn--primary" href="/downloads">Download Nod</a>
        <p class="get__note">
          macOS, Windows, and Linux — or install with{" "}<a
            href="/downloads#homebrew">Homebrew</a
          >. Free to try for 14 days.
        </p>
      </div>
    </section>

    <section class="wrap feats" aria-label="Features in action">
      <p class="eyebrow feats__eyebrow">In action</p>
      <div class="feats__rows">
        <FeatureKeys />
        <FeatureCache />
        <FeatureResume />
      </div>
    </section>

    <section class="wrap pricing" aria-label="Pricing" id="pricing">
      <p class="eyebrow">Pricing</p>
      <div class="pricing__card">
        <p class="pricing__price">
          $29 <span class="pricing__term">one-time · a year of updates</span>
        </p>
        <p class="pricing__copy">
          Every feature is free for 14 days. After that Nod keeps working —
          forever — and a license keeps the updates coming.
        </p>
        {
          checkoutUrl ? (
            <a class="btn btn--primary" href={checkoutUrl}>
              Buy Nod
            </a>
          ) : (
            <a class="btn btn--primary" href="/downloads">
              Start the free intro
            </a>
          )
        }
        {
          !checkoutUrl && (
            <p class="pricing__note">
              Purchasing opens soon — the intro is full-featured.
            </p>
          )
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

---
// Resume-instantly feature row: the app relaunches straight into the file
// and scroll position the last session ended on. The loop (11s, one shared
// duration, slots in percentages): 0-13 holds the end-of-last-session frame
// without the chip, 13-26 the shade dims the window to near-dark (quit),
// 26-27 the shade snaps away in one step (relaunch — same cursor row, same
// thumb, no progressive reveal), 30-34 the "resumed" chip pops in, then the
// composed frame holds until the chip fades back out at 93-98. Reduced
// motion freezes on the composed frame — content restored, cursor on line
// 128, thumb mid-file, chip visible — which is exactly the static state
// below. Styles are scoped so the miniatures animate independently.
---

<article class="feat">
  <div class="feat__copy">
    <h2 class="feat__title">Resume instantly</h2>
    <p class="feat__body">
      Launch straight back into the last PR — the same file and scroll position
      you left it on.
    </p>
  </div>

  <figure
    class="mini"
    aria-label="Nod relaunching into the same file and scroll position the previous session ended on."
  >
    <div class="mini__window" aria-hidden="true">
      <div class="file">
        <div class="file__bar">
          <span class="file__name mono">review.ts</span>
          <span class="file__pos mono">line 128</span>
        </div>
        <div class="file__body">
          <div class="file__code mono">
            <div class="file__line">
              <span class="file__ln">125</span><span
                ><span class="file__tok--key">if</span> (!thread.resolved) {'{'}</span
              >
            </div>
            <div class="file__line">
              <span class="file__ln">126</span><span
                >  queue.<span class="file__tok--fn">push</span>(thread)</span
              >
            </div>
            <div class="file__line">
              <span class="file__ln">127</span><span>{'}'}</span>
            </div>
            <div class="file__line file__line--cursor">
              <span class="file__ln">128</span><span
                ><span class="file__tok--key">return</span> queue</span
              >
            </div>
            <div class="file__line">
              <span class="file__ln">129</span><span>{'}'}</span>
            </div>
          </div>
          <div class="file__rail">
            <span class="file__thumb"></span>
          </div>
        </div>
        <div class="file__shade"></div>
        <div class="file__chip mono">resumed · review.ts:128</div>
      </div>
    </div>
    <figcaption class="mini__caption">
      relaunch — same file, same scroll position
    </figcaption>
  </figure>
</article>

<style>
  .file {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .file__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42px;
    flex-shrink: 0;
    padding-inline: 16px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface-2), transparent);
    font-size: 11.5px;
    color: var(--muted);
  }

  .file__pos {
    font-size: 10.5px;
    color: var(--faint);
  }

  .file__body {
    position: relative;
    flex: 1;
  }

  .file__code {
    padding-block: 12px;
    font-size: 12px;
    line-height: 34px;
  }

  .file__line {
    display: grid;
    grid-template-columns: 46px 1fr;
    height: 34px;
    padding-right: 24px;
    white-space: pre;
  }

  .file__ln {
    color: var(--faint);
    font-size: 10.5px;
    text-align: right;
    padding-right: 12px;
  }

  .file__line--cursor {
    background: var(--accent-soft);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .file__tok--key {
    color: var(--accent);
  }

  .file__tok--fn {
    color: #cdb8ff;
  }

  .file__rail {
    position: absolute;
    top: 8px;
    bottom: 8px;
    right: 5px;
    width: 4px;
    border-radius: 999px;
    background: var(--line);
  }

  .file__thumb {
    position: absolute;
    top: 52%;
    width: 100%;
    height: 34px;
    border-radius: 999px;
    background: var(--faint);
  }

  .file__shade {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0;
    pointer-events: none;
  }

  .file__chip {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 4px 9px;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--surface-hi);
    font-size: 10.5px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .file__shade {
      animation: fr-shade 11s ease infinite;
    }

    .file__chip {
      animation: fr-chip 11s ease infinite;
    }

    @keyframes fr-shade {
      0%,
      13% {
        opacity: 0;
      }
      18%,
      26% {
        opacity: 1;
      }
      27%,
      100% {
        opacity: 0;
      }
    }

    @keyframes fr-chip {
      0%,
      30% {
        opacity: 0;
        transform: scale(0.5);
      }
      34%,
      93% {
        opacity: 1;
        transform: scale(1);
      }
      98%,
      100% {
        opacity: 0;
        transform: scale(0.5);
      }
    }
  }
</style>

---
/**
 * `cta` is optional: /buy passes none, because the only nav affordance there
 * used to be a free Download sitting next to a paid Continue with GitHub.
 * The brand stays a link so the page keeps a way back out.
 */
interface Props {
  cta?: { href: string; label: string };
}

const { cta } = Astro.props;
---

<header class="nav">
  <div class="wide nav__inner">
    <a class="brand" href="/">
      <span class="brand__mark">nod</span>
      <span class="brand__dim">· pr review</span>
    </a>
    {cta && <a class="nav__link" href={cta.href}>{cta.label}</a>}
  </div>
</header>

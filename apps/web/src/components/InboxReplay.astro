        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      43%,
      45% {
        color: var(--add);
        border-color: rgba(95, 208, 138, 0.5);
        box-shadow: 0 0 0 3px rgba(95, 208, 138, 0.16);
      }
      49%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }

    @keyframes ir-key-jk {
      0%,
      52% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      54%,
      56% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      60%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }
  }
</style>

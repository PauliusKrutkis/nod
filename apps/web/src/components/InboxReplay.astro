    }
    .ir__badge-n--7 {
      animation: ir-badge7 12s ease infinite;
    }
    .ir__badge-n--6 {
      animation: ir-badge6 12s ease infinite;
    }
    .ir__card--1 {
      animation: ir-card1 12s ease infinite;
    }
    .ir__card--2 {
      animation: ir-card2 12s ease infinite;
    }
    .ir__card--3 {
      animation: ir-card3 12s ease infinite;
    }
    .ir__card--4 {
      animation: ir-card4 12s ease infinite;
    }
    .ir__cursor {
      animation: ir-cursor 12s cubic-bezier(0.7, 0, 0.2, 1) infinite;
    }
    .ir__key[data-k="enter"] {
      animation: ir-key-enter 12s ease infinite;
    }
    .ir__key[data-k="e"] {
      animation: ir-key-e 12s ease infinite;
    }
    .ir__key[data-k="jk"] {
      animation: ir-key-jk 12s ease infinite;
    }

    @keyframes ir-out1 {
      0%,
      22% {
        height: var(--ir-row);
        opacity: 1;
      }
      26%,
      100% {
        height: 0;
        opacity: 0;

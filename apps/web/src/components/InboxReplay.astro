---
// The hero's signature element: the Nod inbox triaging itself, making the
// headline literal — the queue drains like mail, it doesn't get navigated
// like a website. One shared 12s pure-CSS loop, zero JS. Slots: rest on the
// full queue (badge 8) -> Enter flashes and a "reviewed" chip pops on the
// top row (the review itself is elided; the footage sections below show it)
// -> E archives the row, it collapses inside the clipped list while the
// queue slides up under the cursor and the badge ticks down -> the same
// beat repeats on the next row -> one j step -> long rest on the composed
// frame. The list viewport is fixed at six rows and the markup carries
// eight, so the frame stays full while rows leave; the page around the
// window never moves. The static markup IS the composed frame (badge 6,
// archived rows collapsed, cursor on the second visible row), which is what
// prefers-reduced-motion shows. Keyframes carry the `ir-` prefix — Astro
// does not namespace them.
---

<figure
  class="ir"
  aria-label="The Nod inbox triaging itself: Enter opens a review request, E archives the reviewed one, the queue slides up and the count ticks down."
>
  <div class="ir__window" aria-hidden="true">
    <div class="ir__head">
      <span class="ir__tab">
        Review requests
        <span class="ir__badge mono">
          <span class="ir__badge-n ir__badge-n--8">8</span>
          <span class="ir__badge-n ir__badge-n--7">7</span>
          <span class="ir__badge-n ir__badge-n--6">6</span>
        </span>
      </span>
      <span class="ir__head-dim mono">acme/rocket</span>
    </div>
    <div class="ir__list">
      <div class="ir__cursor"></div>
      <div class="ir__row ir__row--out1">
        <span class="ir__dot"></span>
        <span class="ir__title">Fix cursor drift in diff viewer</span>
        <span class="ir__chip mono">reviewed ✓</span>
        <span class="ir__meta mono">#62 · 1h</span>
      </div>
      <div class="ir__row ir__row--out2">
        <span class="ir__dot"></span>
        <span class="ir__title">Rework the token gate</span>
        <span class="ir__chip mono">reviewed ✓</span>
        <span class="ir__meta mono">#60 · 2h</span>
      </div>
      <div class="ir__row">
        <span class="ir__dot"></span>
        <span class="ir__title">Handle empty cache on open</span>
        <span class="ir__meta mono">#58 · 3h</span>
      </div>
      <div class="ir__row">
        <span class="ir__dot"></span>
        <span class="ir__title">Add fuzzy matching to search</span>
        <span class="ir__meta mono">#61 · 4h</span>
      </div>
      <div class="ir__row">
        <span class="ir__dot"></span>
        <span class="ir__title">Restore scroll position on relaunch</span>
        <span class="ir__meta mono">#57 · 5h</span>
      </div>
      <div class="ir__row">
        <span class="ir__dot"></span>
        <span class="ir__title">Quiet background refresh</span>
        <span class="ir__meta mono">#55 · 1d</span>
      </div>
      <div class="ir__row">
        <span class="ir__dot"></span>
        <span class="ir__title">Snapshot store for offline diffs</span>
        <span class="ir__meta mono">#54 · 1d</span>
      </div>
      <div class="ir__row">
        <span class="ir__dot"></span>
        <span class="ir__title">Keyboard map for review actions</span>
        <span class="ir__meta mono">#52 · 2d</span>
      </div>
    </div>
  </div>

  <figcaption class="ir__keys">
    <span><kbd class="ir__key" data-k="jk">j k</kbd> move</span>
    <span><kbd class="ir__key" data-k="enter">↵</kbd> open review</span>
    <span><kbd class="ir__key" data-k="e">E</kbd> archive</span>
  </figcaption>
</figure>

<style>
  .ir {
    --ir-row: 36px;
    margin: 48px auto 0;
    max-width: 640px;
    text-align: left;
  }

  .ir__window {
    height: 260px;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line-2);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.03) inset,
      0 30px 80px -40px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  .ir__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    flex-shrink: 0;
    padding-inline: 16px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface-2), transparent);
  }

  .ir__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--fg);
  }

  .ir__badge {
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding-inline: 5px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 10.5px;
  }

  .ir__badge-n {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .ir__badge-n--6 {
    opacity: 1;
  }

  .ir__head-dim {
    font-size: 11px;
    color: var(--faint);
  }

  .ir__list {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .ir__cursor {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--ir-row);
    background: var(--accent-soft);
    border-left: 2px solid var(--accent);
    transform: translateY(var(--ir-row));
  }

  .ir__row {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--ir-row);
    padding-inline: 16px;
    font-size: 13px;
    color: var(--muted);
    overflow: hidden;
  }

  .ir__row--out1,
  .ir__row--out2 {
    height: 0;
    opacity: 0;
  }

  .ir__dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--add);
  }

  .ir__title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ir__chip {
    flex-shrink: 0;
    padding: 2px 7px;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--surface-hi);
    font-size: 10px;
    color: var(--accent);
    opacity: 0;
  }

  .ir__meta {
    flex-shrink: 0;
    font-size: 10.5px;
    color: var(--faint);
  }

  .ir__keys {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding-top: 14px;
    font-size: 12px;
    color: var(--faint);
  }

  .ir__keys > span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .ir__key {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding-inline: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    background: var(--surface-hi);
    border: 1px solid var(--line-2);
    border-radius: 6px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
  }

  @media (max-width: 560px) {
    .ir__meta,
    .ir__head-dim {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ir__row--out1 {
      animation: ir-out1 12s ease infinite;
    }
    .ir__row--out2 {
      animation: ir-out2 12s ease infinite;
    }
    .ir__row--out1 .ir__chip {
      animation: ir-chip1 12s ease infinite;
    }
    .ir__row--out2 .ir__chip {
      animation: ir-chip2 12s ease infinite;
    }
    .ir__badge-n--8 {
      animation: ir-badge8 12s ease infinite;
    }
    .ir__badge-n--7 {
      animation: ir-badge7 12s ease infinite;
    }
    .ir__badge-n--6 {
      animation: ir-badge6 12s ease infinite;
    }
    .ir__cursor {
      animation: ir-cursor 12s cubic-bezier(0.7, 0, 0.2, 1) infinite;
    }
    .ir__key[data-k="enter"] {
      animation: ir-key-enter 12s ease infinite;
    }
    .ir__key[data-k="e"] {
      animation: ir-key-e 12s ease infinite;
    }
    .ir__key[data-k="jk"] {
      animation: ir-key-jk 12s ease infinite;
    }

    @keyframes ir-out1 {
      0%,
      22% {
        height: var(--ir-row);
        opacity: 1;
      }
      26%,
      100% {
        height: 0;
        opacity: 0;
      }
    }

    @keyframes ir-out2 {
      0%,
      44% {
        height: var(--ir-row);
        opacity: 1;
      }
      48%,
      100% {
        height: 0;
        opacity: 0;
      }
    }

    @keyframes ir-chip1 {
      0%,
      11% {
        opacity: 0;
        transform: scale(0.6);
      }
      14%,
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes ir-chip2 {
      0%,
      33% {
        opacity: 0;
        transform: scale(0.6);
      }
      36%,
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes ir-badge8 {
      0%,
      25% {
        opacity: 1;
      }
      26%,
      100% {
        opacity: 0;
      }
    }

    @keyframes ir-badge7 {
      0%,
      25% {
        opacity: 0;
      }
      26%,
      47% {
        opacity: 1;
      }
      48%,
      100% {
        opacity: 0;
      }
    }

    @keyframes ir-badge6 {
      0%,
      47% {
        opacity: 0;
      }
      48%,
      100% {
        opacity: 1;
      }
    }

    @keyframes ir-cursor {
      0%,
      53% {
        transform: translateY(0);
      }
      56%,
      94% {
        transform: translateY(var(--ir-row));
      }
      99%,
      100% {
        transform: translateY(0);
      }
    }

    @keyframes ir-key-enter {
      0%,
      9% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      11%,
      13% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      17%,
      31% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      33%,
      35% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      39%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }

    @keyframes ir-key-e {
      0%,
      19% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      21%,
      23% {
        color: var(--add);
        border-color: rgba(95, 208, 138, 0.5);
        box-shadow: 0 0 0 3px rgba(95, 208, 138, 0.16);
      }
      27%,
      41% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      43%,
      45% {
        color: var(--add);
        border-color: rgba(95, 208, 138, 0.5);
        box-shadow: 0 0 0 3px rgba(95, 208, 138, 0.16);
      }
      49%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }

    @keyframes ir-key-jk {
      0%,
      52% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      54%,
      56% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      60%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }
  }
</style>

    @keyframes ir-card1 {
      0%,
      24% {
        opacity: 1;
      }
      27%,
      100% {
        opacity: 0;
      }
    }

    @keyframes ir-card2 {
      0%,
      24% {
        opacity: 0;
      }
      27%,
      45% {
        opacity: 1;
      }
      48%,
      100% {
        opacity: 0;
      }
    }

    @keyframes ir-card3 {

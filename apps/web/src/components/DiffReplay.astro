---
// The signature element: a miniature of the real app that reviews a PR by
// itself. The window has a fixed height, so the inline comment inserts into
// the diff flow (rows below slide and clip inside the frame) without ever
// moving the page around it. All motion lives in global.css so the markup
// stays plain — and screen readers get the figure caption instead.
---

<figure
  class="dr"
  aria-label="A keyboard-driven review in the Nod app: step down the diff with j, open an inline comment with c, and mark the file viewed with e."
>
  <div class="dr__window" aria-hidden="true">
    <aside class="dr__side">
      <div class="dr__side-head">
        <span>Files</span>
        <span class="dr__count">
          <span class="dr__count-before">2/3 viewed</span>
          <span class="dr__count-after">3/3 viewed</span>
        </span>
      </div>
      <div class="dr__fileitem dr__fileitem--done">
        <span class="dr__status dr__status--m">M</span>
        <span class="dr__filename">cache.ts</span>
        <span class="dr__check">✓</span>
      </div>
      <div class="dr__fileitem dr__fileitem--done">
        <span class="dr__status dr__status--a">A</span>
        <span class="dr__filename">routes.ts</span>
        <span class="dr__check">✓</span>
      </div>
      <div class="dr__fileitem dr__fileitem--active">
        <span class="dr__status dr__status--m">M</span>
        <span class="dr__filename">review.ts</span>
        <span class="dr__check dr__check--pending">✓</span>
      </div>
    </aside>

    <div class="dr__main">
      <div class="dr__bar">
        <span class="dr__pill"><span class="dr__pill-dot"></span>Open</span>
        <span class="dr__title">Handle empty cache on open</span>
        <span class="dr__meta mono">#58</span>
        <span class="dr__spacer"></span>
        <span class="dr__review">
          Review <kbd class="dr__review-kbd">s</kbd>
          <span class="dr__review-badge">1</span>
        </span>
      </div>

      <div class="dr__code">
        <div class="dr__cursor"></div>

        <div class="dr__hunk mono">@@ -11,4 +11,5 @@</div>
        <div class="dr__line">
          <span class="dr__ln">11</span><span class="dr__ln">11</span><span
            class="dr__sign"></span><span
            ><span class="dr__tok--key">const</span> id = route.params.id</span
          >
        </div>
        <div class="dr__line">
          <span class="dr__ln">12</span><span class="dr__ln">12</span><span
            class="dr__sign"></span><span
            ><span class="dr__tok--key">const</span> pr = <span
              class="dr__tok--key">await</span
            > cache.<span class="dr__tok--fn">get</span>(id)</span
          >
        </div>
        <div class="dr__line dr__line--add">
          <span class="dr__ln"></span><span class="dr__ln">13</span><span
            class="dr__sign">+</span><span class="dr__code-text"
            ><span class="dr__tok--key">if</span> (!pr) <span
              class="dr__tok--key">return</span
            > &lt;Empty /&gt;</span
          >
        </div>
        <div class="dr__composer">
          <div class="dr__composer-inner">
            <span class="dr__avatar">pk</span>
            <span
              ><span class="dr__caret">›</span> nice — matches the cache-first
              path</span
            >
          </div>
        </div>

        <div class="dr__line">
          <span class="dr__ln">13</span><span class="dr__ln">14</span><span
            class="dr__sign"></span><span
            ><span class="dr__tok--fn">render</span>(pr)</span
          >
        </div>
        <div class="dr__line">
          <span class="dr__ln">14</span><span class="dr__ln">15</span><span
            class="dr__sign"></span><span
            ><span class="dr__tok--fn">markSeen</span>(id)</span
          >
        </div>
        <div class="dr__line">
          <span class="dr__ln">15</span><span class="dr__ln">16</span><span
            class="dr__sign"></span><span>{"}"}</span>
        </div>
        <div class="dr__line">
          <span class="dr__ln">16</span><span class="dr__ln">17</span><span
            class="dr__sign"></span><span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="dr__keys">
    <span><kbd class="dr__key" data-k="j">j</kbd> next line</span>
    <span><kbd class="dr__key" data-k="c">c</kbd> comment</span>
    <span><kbd class="dr__key" data-k="e">e</kbd> mark viewed</span>
  </div>
</figure>

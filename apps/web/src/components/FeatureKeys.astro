---
// Keyboard-first feature row: the PR inbox miniature, animated as a pure-CSS
// loop on one shared 12s timeline. Slots: rest on row 1, two `j` flashes step
// the cursor to row 3 (the composed frame), a beat, then `o` flashes and the
// cursor bar pulses to acknowledge the open; the loop rests on the composed
// frame for most of its length before snapping back to row 1. Row brightening
// travels with the cursor via per-row keyframes, while `--active` stays on
// row 3 so reduced motion freezes exactly on the composed frame. Styles are
// scoped here (unlike the hero's .dr, which lives in global.css) so the three
// feature miniatures can animate independently; keyframes carry the `fk-`
// prefix because Astro does not namespace them.
---

<article class="feat">
  <div class="feat__copy">
    <h2 class="feat__title">Keyboard-first</h2>
    <p class="feat__body">
      Move through PRs, files, hunks, and comment threads without ever reaching
      for the mouse.
    </p>
  </div>

  <figure
    class="mini"
    aria-label="The Nod inbox: a list of open pull requests stepped through with the j and k keys."
  >
    <div class="mini__window" aria-hidden="true">
      <div class="inbox">
        <div class="inbox__head">
          <span>Inbox</span>
          <span class="inbox__count mono">5 open</span>
        </div>
        <div class="inbox__list">
          <div class="inbox__cursor"></div>
          <div class="inbox__row">
            <span class="inbox__dot"></span>
            <span class="inbox__title">Cache eviction for stale diffs</span>
            <span class="inbox__meta mono">#61 · 1h</span>
          </div>
          <div class="inbox__row">
            <span class="inbox__dot"></span>
            <span class="inbox__title">Keyboard map for review actions</span>
            <span class="inbox__meta mono">#62 · 2h</span>
          </div>
          <div class="inbox__row inbox__row--active">
            <span class="inbox__dot"></span>
            <span class="inbox__title">Handle empty cache on open</span>
            <span class="inbox__meta mono">#58 · 3h</span>
          </div>
          <div class="inbox__row">
            <span class="inbox__dot"></span>
            <span class="inbox__title">Restore scroll position on relaunch</span>
            <span class="inbox__meta mono">#57 · 5h</span>
          </div>
          <div class="inbox__row">
            <span class="inbox__dot"></span>
            <span class="inbox__title">Quiet background refresh</span>
            <span class="inbox__meta mono">#55 · 1d</span>
          </div>
        </div>
      </div>
    </div>
    <figcaption class="mini__caption">
      <kbd class="mini__key" data-k="j">j</kbd>
      <kbd class="mini__key" data-k="k">k</kbd> through the queue ·
      <kbd class="mini__key" data-k="o">o</kbd> opens
    </figcaption>
  </figure>
</article>

<style>
  .inbox {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .inbox__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 42px;
    flex-shrink: 0;
    padding-inline: 16px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface-2), transparent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .inbox__count {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-size: 11px;
  }

  .inbox__list {
    position: relative;
    flex: 1;
    padding-block: 6px;
  }

  .inbox__cursor {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: 37px;
    background: var(--accent-soft);
    border-left: 2px solid var(--accent);
    transform: translateY(74px);
  }

  .inbox__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 37px;
    padding-inline: 16px;
    font-size: 12.5px;
    color: var(--muted);
  }

  .inbox__row--active {
    color: var(--fg);
  }

  .inbox__dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--add);
  }

  .inbox__title {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .inbox__meta {
    flex-shrink: 0;
    font-size: 10.5px;
    color: var(--faint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .inbox__cursor {
      animation:
        fk-cursor 12s cubic-bezier(0.7, 0, 0.2, 1) infinite,
        fk-open 12s ease infinite;
    }
    .inbox__row:nth-child(2) {
      animation: fk-row-1 12s ease infinite;
    }
    .inbox__row:nth-child(3) {
      animation: fk-row-2 12s ease infinite;
    }
    .inbox__row--active {
      animation: fk-row-3 12s ease infinite;
    }
    .mini__key[data-k="j"] {
      animation: fk-key-j 12s ease infinite;
    }
    .mini__key[data-k="o"] {
      animation: fk-key-o 12s ease infinite;
    }

    @keyframes fk-cursor {
      0%,
      8% {
        transform: translateY(0);
      }
      13%,
      18% {
        transform: translateY(37px);
      }
      23%,
      92% {
        transform: translateY(74px);
      }
      98%,
      100% {
        transform: translateY(0);
      }
    }

    @keyframes fk-open {
      0%,
      29% {
        background: var(--accent-soft);
        box-shadow: 0 0 0 rgba(139, 128, 255, 0);
      }
      31%,
      33% {
        background: rgba(139, 128, 255, 0.3);
        box-shadow: 0 0 20px rgba(139, 128, 255, 0.25);
      }
      38%,
      100% {
        background: var(--accent-soft);
        box-shadow: 0 0 0 rgba(139, 128, 255, 0);
      }
    }

    @keyframes fk-row-1 {
      0%,
      9% {
        color: var(--fg);
      }
      14%,
      93% {
        color: var(--muted);
      }
      99%,
      100% {
        color: var(--fg);
      }
    }

    @keyframes fk-row-2 {
      0%,
      9% {
        color: var(--muted);
      }
      14%,
      18% {
        color: var(--fg);
      }
      23%,
      100% {
        color: var(--muted);
      }
    }

    @keyframes fk-row-3 {
      0%,
      18% {
        color: var(--muted);
      }
      23%,
      93% {
        color: var(--fg);
      }
      99%,
      100% {
        color: var(--muted);
      }
    }

    @keyframes fk-key-j {
      0%,
      9% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      11%,
      12% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      15% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      17%,
      18% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      21%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }

    @keyframes fk-key-o {
      0%,
      28% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
      30%,
      32% {
        color: var(--accent);
        border-color: var(--accent-line);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      36%,
      100% {
        color: var(--muted);
        border-color: var(--line-2);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.45);
      }
    }
  }
</style>

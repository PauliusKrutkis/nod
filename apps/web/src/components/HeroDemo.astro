---
// The hero IS the app: a poster of the demo queue (regenerate with
// `pnpm capture:landing`) that swaps for the real frontend — the /demo/
// bundle built from apps/desktop — when the visitor starts it. Starting is
// keyboard-first like everything else: `j` anywhere on the page, a click on
// the poster, or the start button. The iframe keeps the app's keyboard
// fully contained: keys only reach it while it has focus, so the page never
// hijacks typing or scrolling, and clicking outside hands focus back.
// Coarse pointers and narrow viewports open /demo/ in its own tab instead
// of embedding a keyboard app where there is no keyboard. Nothing from the
// 780KB demo bundle loads until the visitor asks for it — idle visitors pay
// only for the poster. Launch guards: the start button's click stops
// propagation because the frame's click-to-start would otherwise relaunch
// on bubble, and the page-wide j hotkey ignores modifier chords, editable
// targets, and auto-repeat — an unguarded window.open would spawn a tab per
// repeated keydown while j is held. The hotkey exists only where the embed
// does, and the hd__when-* media queries mirror the embeddable() check, so
// the button and caption never promise a keycap (or a click-outside) where
// the demo actually opens in a new tab.
---

<figure
  class="hd"
  aria-label="A live, keyboard-driveable build of the real Nod frontend running on fixture pull requests."
>
  <div class="hd__frame">
    <img
      alt=""
      class="hd__poster"
      decoding="async"
      height="588"
      src="/landing/hero.png"
      width="940"
    />
    <button class="hd__start" type="button">
      <span class="hd__when-embedded"
        >Try the real app — press <kbd class="hd__kbd mono">j</kbd></span
      >
      <span class="hd__when-tab">Try the real app</span>
    </button>
  </div>
  <figcaption class="hd__caption mono">
    <span class="hd__when-embedded"
      >the actual Nod frontend on fixture PRs — click outside to leave</span
    >
    <span class="hd__when-tab"
      >the actual Nod frontend on fixture PRs — opens in a new tab</span
    >
  </figcaption>
</figure>

<script>
  const frame = document.querySelector<HTMLElement>(".hd__frame");
  const start = document.querySelector<HTMLButtonElement>(".hd__start");

  const embeddable = () =>
    !matchMedia("(pointer: coarse)").matches && window.innerWidth >= 720;

  const launch = () => {
    if (!frame || frame.classList.contains("hd__frame--live")) {
      return;
    }
    if (!embeddable()) {
      window.open("/demo/", "_blank", "noopener");
      return;
    }
    const demo = document.createElement("iframe");
    demo.className = "hd__iframe";
    demo.src = "/demo/";
    demo.title = "Nod live demo";
    demo.addEventListener("load", () => {
      demo.contentWindow?.focus();
    });
    frame.append(demo);
    frame.classList.add("hd__frame--live");
  };

  start?.addEventListener("click", (event) => {
    event.stopPropagation();
    launch();
  });
  frame?.addEventListener("click", launch);

  window.addEventListener("keydown", (event) => {
    if (
      event.key !== "j" ||
      event.repeat ||
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      !embeddable()
    ) {
      return;
    }
    const target = event.target as HTMLElement | null;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target?.isContentEditable
    ) {
      return;
    }
    frame?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    launch();
  });
</script>

<style>
  .hd {
    margin: 44px auto 0;
    max-width: 940px;
    text-align: left;
  }

  .hd__frame {
    position: relative;
    aspect-ratio: 940 / 588;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.03) inset,
      0 30px 80px -40px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  .hd__frame:not(.hd__frame--live) {
    cursor: pointer;
  }

  .hd__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hd__start {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: var(--accent);
    color: #14111f;
    font-size: 14px;
    font-weight: 550;
    cursor: pointer;
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease;
  }

  .hd__start:hover {
    background: #9a90ff;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hd__frame--live .hd__poster,
  .hd__frame--live .hd__start {
    display: none;
  }

  .hd__kbd {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 5px;
    border-radius: 5px;
    background: rgba(20, 17, 31, 0.18);
    font-size: 12px;
  }

  :global(.hd__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .hd__caption {
    padding-top: 12px;
    text-align: center;
    font-size: 12px;
    color: var(--faint);
  }

  .hd__when-embedded {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hd__when-tab {
    display: none;
  }

  @media (max-width: 719.9px), (pointer: coarse) {
    .hd__when-embedded {
      display: none;
    }

    .hd__when-tab {
      display: inline;
    }
  }
</style>

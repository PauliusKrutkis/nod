---
// The hero IS the app: a poster of the demo queue (regenerate with
// `pnpm capture:landing`) that swaps for the real frontend — the /demo/
// bundle built from apps/desktop — when the visitor starts it. Starting is
// keyboard-first like everything else: `j` anywhere on the page, a click on
// the poster, or the start button. The iframe keeps the app's keyboard
// fully contained: keys only reach it while it has focus, so the page never
// hijacks typing or scrolling, and clicking outside hands focus back.
// Coarse pointers and narrow viewports open /demo/ in its own tab instead
// of embedding a keyboard app where there is no keyboard. Nothing from the
// 780KB demo bundle loads until the visitor asks for it — idle visitors pay
// only for the poster.
---

<figure
  class="hd"
  aria-label="A live, keyboard-driveable build of the real Nod frontend running on fixture pull requests."
>
  <div class="hd__frame">
    <img
      alt=""
      class="hd__poster"
      decoding="async"
      fetchpriority="high"
      height="900"
      sizes="(max-width: 719.9px) 100vw, min(1400px, 100vw - 48px)"
      src="/landing/hero.webp"
      srcset="/landing/hero-1600.webp 1600w, /landing/hero.webp 3200w"
      width="1600"
    />
    <button class="hd__start" type="button">
      <span class="hd__when-embedded"
        >Try the real app — press <kbd class="hd__kbd mono">j</kbd></span
      >
      <span class="hd__when-tab">Try the real app</span>
    </button>
    <button class="hd__fullscreen mono" type="button" hidden
      >⛶ full screen</button
    >
  </div>
  <figcaption class="hd__caption mono">
    <span class="hd__when-embedded"
      >the actual Nod frontend on fixture PRs — click outside to leave</span
    >
    <span class="hd__when-tab"
      >the actual Nod frontend on fixture PRs — opens in a new tab</span
    >
  </figcaption>
</figure>

<script>
  const frame = document.querySelector<HTMLElement>(".hd__frame");
  const start = document.querySelector<HTMLButtonElement>(".hd__start");
  const fullscreenToggle =
    document.querySelector<HTMLButtonElement>(".hd__fullscreen");

  const embeddable = () =>
    !matchMedia("(pointer: coarse)").matches && window.innerWidth >= 720;

  const focusDemo = () => {
    frame
      ?.querySelector<HTMLIFrameElement>(".hd__iframe")
      ?.contentWindow?.focus();
  };

  const launch = () => {
    if (!frame || frame.classList.contains("hd__frame--live")) {
      return;
    }
    if (!embeddable()) {
      window.open("/demo/", "_blank", "noopener");
      return;
    }
    const demo = document.createElement("iframe");
    demo.className = "hd__iframe";
    demo.src = "/demo/";
    demo.title = "Nod live demo";
    demo.addEventListener("load", () => {
      demo.contentWindow?.focus();
    });
    frame.append(demo);
    frame.classList.add("hd__frame--live");
    if (document.fullscreenEnabled && fullscreenToggle) {
      fullscreenToggle.hidden = false;
    }
  };

  start?.addEventListener("click", (event) => {
    // The frame's click-to-start would otherwise relaunch on bubble.
    event.stopPropagation();
    launch();
  });
  frame?.addEventListener("click", launch);

  // The transition promises reject when the browser denies the switch; the
  // fullscreenchange listener below is the source of truth either way.
  fullscreenToggle?.addEventListener("click", () => {
    if (document.fullscreenElement) {
      document.exitFullscreen().catch(() => {
        /* ignore */
      });
    } else {
      frame?.requestFullscreen().catch(() => {
        /* ignore */
      });
    }
  });

  // Entering or leaving fullscreen lands focus on the toggle; the demo
  // should keep the keyboard either way.
  document.addEventListener("fullscreenchange", () => {
    if (fullscreenToggle) {
      fullscreenToggle.textContent = document.fullscreenElement
        ? "✕ exit full screen"
        : "⛶ full screen";
    }
    focusDemo();
  });

  // The start button promises "press j" — honor it page-wide. Once the demo
  // is live the iframe owns the keyboard, so this only ever starts it. The
  // hotkey exists only where the embed does: on new-tab viewports the button
  // never promises a keycap, and an unguarded window.open would otherwise
  // spawn a tab per auto-repeated keydown while j is held.
  window.addEventListener("keydown", (event) => {
    if (
      event.key !== "j" ||
      event.repeat ||
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      !embeddable()
    ) {
      return;
    }
    const target = event.target as HTMLElement | null;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target?.isContentEditable
    ) {
      return;
    }
    frame?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    launch();
  });
</script>

<style>
  .hd {
    margin: clamp(28px, 4vh, 44px) auto 0;
    width: min(var(--wide), 100% - 48px);
    text-align: left;
  }

  .hd__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    /* vh first: browsers without svh drop that line and still get a cap. */
    max-height: 76vh;
    max-height: 76svh;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.03) inset,
      0 30px 80px -40px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  .hd__frame:not(.hd__frame--live) {
    cursor: pointer;
  }

  .hd__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .hd__start {
    position: absolute;
    left: 50%;
    /* A third of the way down, not centered: the frame's lower half sits
       below the fold on 900px-tall laptops, and the start affordance must
       never scroll to be seen. */
    top: 33%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border: 1px solid transparent;
    border-radius: 10px;
    background: var(--accent);
    color: #14111f;
    font-size: 14.5px;
    font-weight: 550;
    cursor: pointer;
    box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.8);
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease;
  }

  .hd__start:hover {
    background: #9a90ff;
    box-shadow:
      0 12px 40px -12px rgba(0, 0, 0, 0.8),
      0 0 0 3px var(--accent-soft);
  }

  .hd__frame--live .hd__poster,
  .hd__frame--live .hd__start {
    display: none;
  }

  .hd__fullscreen {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    padding: 6px 10px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    background: rgba(15, 15, 23, 0.78);
    color: var(--muted);
    font-size: 12px;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .hd__fullscreen:hover {
    color: var(--fg);
    border-color: var(--accent-line);
  }

  .hd__fullscreen[hidden] {
    display: none;
  }

  .hd__frame:fullscreen {
    aspect-ratio: auto;
    max-height: none;
    border: 0;
    border-radius: 0;
  }

  .hd__kbd {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 5px;
    border-radius: 5px;
    background: rgba(20, 17, 31, 0.18);
    font-size: 12px;
  }

  :global(.hd__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .hd__caption {
    padding-top: 12px;
    text-align: center;
    font-size: 12px;
    color: var(--faint);
  }

  /* Copy tracks behavior: these media queries mirror the embeddable() check
     in the script, so the button and caption never promise an embed (or a
     keyboard) where the demo actually opens in a new tab. */
  .hd__when-embedded {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hd__when-tab {
    display: none;
  }

  @media (max-width: 719.9px), (pointer: coarse) {
    .hd__when-embedded {
      display: none;
    }

    .hd__when-tab {
      display: inline;
    }
  }
</style>

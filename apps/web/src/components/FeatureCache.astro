---
// Cache-first feature row: a PR pane that paints from the local cache. One
// shared 10s CSS loop, zero JS. Slots: a blank "just opened" beat (0–5%),
// then every code line and the cache-hit readout paint at once by 6.5% — no
// skeleton, no stagger — a dim "syncing…" eases in around 28% and crossfades
// to the synced tick near 45%, and the composed frame holds until a quick
// fade at 93–97%. Reduced motion skips the loop and freezes on the composed
// frame, which is exactly the static markup below. Styles are scoped so the
// miniatures animate independently.
---

<article class="feat">
  <div class="feat__copy">
    <h2 class="feat__title">Cache-first</h2>
    <p class="feat__body">
      Everything you've seen paints instantly from a local cache. The network
      refreshes quietly in the background.
    </p>
  </div>

  <figure
    class="mini"
    aria-label="A pull request pane in Nod, painted instantly from the local cache while the network syncs in the background."
  >
    <div class="mini__window" aria-hidden="true">
      <div class="pane">
        <div class="pane__bar mini__bar">
          <span class="pane__pill"><span class="pane__dot"></span>Open</span>
          <span class="pane__title">Quiet background refresh</span>
          <span class="pane__meta mono">#55</span>
        </div>
        <div class="pane__code mono">
          <div class="pane__line">
            <span class="pane__ln">21</span><span class="pane__sign"></span><span
              ><span class="pane__tok--key">const</span> cached = store.<span
                class="pane__tok--fn">read</span
              >(id)</span
            >
          </div>
          <div class="pane__line">
            <span class="pane__ln">22</span><span class="pane__sign"></span><span
              ><span class="pane__tok--key">if</span> (cached) <span
                class="pane__tok--fn">paint</span
              >(cached)</span
            >
          </div>
          <div class="pane__line pane__line--add">
            <span class="pane__ln">23</span><span class="pane__sign">+</span><span
              class="pane__add-text"
              >queue.<span class="pane__tok--fn">refresh</span>(id)</span
            >
          </div>
          <div class="pane__line">
            <span class="pane__ln">24</span><span class="pane__sign"></span><span
              ><span class="pane__tok--fn">render</span>(diff)</span
            >
          </div>
        </div>
        <div class="pane__status mono">
          <span class="pane__hit">cache · 0 ms</span>
          <span class="pane__net">
            <span class="pane__syncing">syncing…</span>
            <span class="pane__sync">synced ✓</span>
          </span>
        </div>
      </div>
    </div>
    <figcaption class="mini__caption">
      painted from cache — refreshed in the background
    </figcaption>
  </figure>
</article>

<style>
  .pane {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pane__bar {
    gap: 10px;
  }

  .pane__pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    padding: 2px 8px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 10.5px;
    color: var(--muted);
  }

  .pane__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--add);
  }

  .pane__title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12.5px;
    font-weight: 550;
  }

  .pane__meta {
    margin-left: auto;
    font-size: 11px;
    color: var(--faint);
  }

  .pane__code {
    flex: 1;
    padding-block: 10px;
    font-size: 12px;
    line-height: 30px;
  }

  .pane__line {
    display: grid;
    grid-template-columns: 40px 18px 1fr;
    height: 30px;
    padding-right: 14px;
    white-space: pre;
  }

  .pane__ln {
    color: var(--faint);
    font-size: 10.5px;
    text-align: right;
    padding-right: 10px;
  }

  .pane__sign {
    text-align: center;
  }

  .pane__line--add {
    background: rgba(95, 208, 138, 0.07);
  }

  .pane__line--add .pane__sign,
  .pane__add-text {
    color: var(--add);
  }

  .pane__tok--key {
    color: var(--accent);
  }

  .pane__tok--fn {
    color: #cdb8ff;
  }

  .pane__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    flex-shrink: 0;
    padding-inline: 14px;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 11px;
    color: var(--faint);
  }

  .pane__net {
    display: grid;
  }

  .pane__syncing,
  .pane__sync {
    grid-area: 1 / 1;
    justify-self: end;
  }

  .pane__syncing {
    opacity: 0;
  }

  .pane__sync {
    color: var(--add);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pane__line,
    .pane__hit {
      animation: fc-paint 10s ease infinite;
    }

    .pane__syncing {
      animation: fc-syncing 10s ease infinite;
    }

    .pane__sync {
      animation: fc-sync 10s ease infinite;
    }

    @keyframes fc-paint {
      0%,
      5% {
        opacity: 0;
      }
      6.5%,
      93% {
        opacity: 1;
      }
      97%,
      100% {
        opacity: 0;
      }
    }

    @keyframes fc-syncing {
      0%,
      27% {
        opacity: 0;
      }
      31%,
      41% {
        opacity: 1;
      }
      45%,
      100% {
        opacity: 0;
      }
    }

    @keyframes fc-sync {
      0%,
      43% {
        opacity: 0;
      }
      48%,
      93% {
        opacity: 1;
      }
      97%,
      100% {
        opacity: 0;
      }
    }
  }
</style>

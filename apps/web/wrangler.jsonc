{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pages Functions config. This is NOT local-dev-only: Cloudflare Pages reads
  // it during every CI build, and once it exists it is authoritative — runtime
  // bindings and vars set in the dashboard are ignored and become read-only
  // there. Add bindings here, not in the UI.
  // Must match the real Cloudflare Pages project, which is `pr-flow` — it
  // predates the rename to Nod and outlived it, because Cloudflare has no
  // rename for a Pages project. Git-integration builds resolve the project
  // from the dashboard and ignore this field, so a wrong value breaks nothing
  // at deploy time; it breaks every `wrangler pages ...` command run from this
  // directory, which is how the secrets below get set.
  "name": "pr-flow",
  "compatibility_date": "2026-07-18",
  "pages_build_output_dir": "dist",
  // Production store. Preview deployments get their own namespace below so PR
  // builds can never write into the one holding real customer licenses;
  // `env.preview` is the Pages mechanism for that, not the Workers-only
  // `preview_id`. KV is a non-inheritable key — if any other binding is ever
  // overridden per environment, every binding must be repeated in that block.
  "kv_namespaces": [
    { "binding": "LICENSES", "id": "6e569935e5a0412e86e87e55cda058b9" }
  ],
  // Public buy-flow config. GH_WEB_CLIENT_ID is the web OAuth app's client
  // id (public by nature; the secret half is a Pages secret), and
  // POLAR_PRODUCT_ID is the *sandbox* Nod license product. Production
  // flip-on (docs/LAUNCH.md step 7) swaps the product id for the
  // production org's and adds POLAR_API_BASE ("https://api.polar.sh") —
  // absent, the code defaults to the sandbox API so a bare deploy can
  // never charge. `vars` is non-inheritable like kv_namespaces: preview
  // deliberately gets none of these, so /buy answers 503 there instead of
  // starting an OAuth flow whose callback URL could never match the
  // registered app.
  //
  // PUBLIC_CF_ANALYTICS_TOKEN is the Cloudflare Web Analytics beacon token,
  // public by definition — it ships in the HTML of every page. It belongs
  // here rather than in the dashboard for the reason at the top of this
  // file: once this block exists it is authoritative, and a plain-text var
  // set only through the API is silently ignored. That is not hypothetical —
  // setting it via the API produced a green deploy whose HTML carried no
  // beacon, and a later `wrangler pages secret put` deleted it outright,
  // leaving the project's plain-text vars exactly matching this block.
  //
  // It is also the first entry here consumed at *build* time — the others are
  // runtime bindings read by Functions (`env.GH_WEB_CLIENT_ID` in
  // buy/start.ts), while the beacon token is read by Base.astro during
  // `astro build`. That difference is worth naming because it looks wrong at
  // a glance; it was verified on a preview deployment carrying this token
  // under `env.preview.vars`, whose HTML did render the beacon. Being in
  // `vars` also means preview inherits none of it, which is what we want:
  // preview traffic must not land in the numbers.
  "vars": {
    "GH_WEB_CLIENT_ID": "Ov23lie6iqyqKu2DdlG9",
    "POLAR_PRODUCT_ID": "3ed56e3a-edbd-4723-a89d-52bdadcba7ac",
    "PUBLIC_CF_ANALYTICS_TOKEN": "92b8fbe9e1ea409484577a3fbc472727"
  },
  "env": {
    "preview": {
      "kv_namespaces": [
        { "binding": "LICENSES", "id": "8a9184da4e5443ef9f63f485436d22dc" }
      ]
    }
  }
  // Secrets are deliberately absent and must stay that way:
  // POLAR_WEBHOOK_SECRET, LICENSE_SIGNING_SEED (32-byte hex Ed25519 seed),
  // POLAR_API_KEY (checkout creation and later /restore),
  // GH_WEB_CLIENT_SECRET (web OAuth app). Set them with
  // `pnpm --filter @nod/web exec wrangler pages secret put <NAME>
  // --project-name pr-flow`, and again with `--env preview` for anything a
  // preview deployment has to exercise — the two environments hold entirely
  // separate secret sets. The keypair's public half is not a
  // binding at all — it ships embedded in the desktop app, which is the only
  // thing that verifies tokens.
}

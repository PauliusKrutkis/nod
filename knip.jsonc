{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Suppress exports tagged @lintignore in source (see knip docs).
  "tags": ["-lintignore"],
  // Rust/Tauri build output — not part of the JS/TS project graph.
  "ignoreFiles": ["**/src-tauri/target/**"],
  "ignoreDependencies": ["@biomejs/biome"],
  // Cloudflare Pages Functions: each file is a route handler invoked by the
  // platform, not imported from anywhere in the JS graph — the Astro plugin
  // only knows about src/pages entries.
  "workspaces": {
    // The landing-footage capture runs through its own playwright config,
    // which the playwright plugin does not auto-detect (it only knows
    // playwright.config.ts).
    "apps/desktop": {
      "entry": [
        "playwright.capture.config.ts",
        "e2e/capture/landing.capture.ts"
      ]
    },
    "apps/web": {
      // scripts/: operator-run one-offs (docs/LAUNCH.md), not imported.
      "entry": ["functions/**/*.ts!", "scripts/*.mjs"]
    }
  }
}

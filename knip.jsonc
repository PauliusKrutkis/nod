{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Suppress exports tagged @lintignore in source (see knip docs).
  "tags": ["-lintignore"],
  // Rust/Tauri build output — not part of the JS/TS project graph. The Nexos
  // probe is a standalone dev script run directly with node (docs/AI.md),
  // never imported.
  "ignoreFiles": ["**/src-tauri/target/**", "scripts/probe-nexos.mjs"],
  "ignoreDependencies": ["@biomejs/biome"],
  // Cloudflare Pages Functions: each file is a route handler invoked by the
  // platform, not imported from anywhere in the JS graph — the Astro plugin
  // only knows about src/pages entries.
  "workspaces": {
    // Capture scenes run through their own playwright config, which the
    // playwright plugin does not auto-detect (it only knows
    // playwright.config.ts).
    "apps/desktop": {
      "entry": ["playwright.capture.config.ts", "e2e/capture/*.capture.ts"]
    },
    "apps/web": {
      "entry": ["functions/**/*.ts!"]
    }
  }
}

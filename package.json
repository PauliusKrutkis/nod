{
  "name": "nod",
  "version": "0.9.2",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @nod/desktop dev",
    "dev:desktop": "pnpm --filter @nod/desktop dev:desktop",
    "dev:web": "pnpm --filter @nod/web dev",
    "build": "pnpm --filter @nod/desktop build",
    "preview": "pnpm --filter @nod/desktop preview",
    "tauri": "pnpm --filter @nod/desktop tauri",
    "typecheck": "pnpm --filter @nod/desktop typecheck && pnpm --filter @nod/gallery typecheck",
    "test": "pnpm --filter @nod/desktop test && pnpm --filter @nod/tokens test && pnpm --filter @nod/ui test && pnpm --filter @nod/gallery test && pnpm --filter @nod/ledger test",
    "test:watch": "pnpm --filter @nod/desktop test:watch",
    "e2e": "pnpm --filter @nod/desktop e2e",
    "e2e:ui": "pnpm --filter @nod/desktop e2e:ui",
    "e2e:web": "playwright test --config apps/web/playwright.config.ts",
    "doctor": "pnpm --filter @nod/desktop doctor",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "capture:landing": "bash scripts/capture-landing.sh",
    "stats:downloads": "node scripts/download-stats.mjs",
    "gallery": "pnpm --filter @nod/gallery dev",
    "ledger": "node packages/ledger/src/cli.ts",
    "build:ledger-sidecar": "node scripts/build-ledger-sidecar.mjs",
    "gallery:notes": "pnpm --filter @nod/gallery notes"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@playwright/test": "^1.61.1",
    "knip": "^6.25.0",
    "ultracite": "7.1.4"
  },
  "knip": {
    "ignoreBinaries": [
      "rustc"
    ]
  }
}
